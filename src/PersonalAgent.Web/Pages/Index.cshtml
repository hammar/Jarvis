@page
@model PersonalAgent.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Jarvis local chat";
}

<main class="app-frame">
    <header class="topbar">
        <h1 class="brand"><a href="/" aria-label="Jarvis home">Jarvis</a><span aria-hidden="true">LOCAL ASSISTANT</span></h1>
        <p id="profile" role="status">Running the @Model.Profile profile.</p>
    </header>
    <section id="auth" class="auth-card" aria-labelledby="auth-title" hidden>
        <div class="eyebrow">A quieter kind of assistant</div>
        <h1 id="auth-title">Owner sign-in</h1>
        <p class="auth-intro">Your conversations stay on this device.</p>
        <form id="auth-form">
            <label id="bootstrap-token-label" for="bootstrap-token" hidden>One-time setup token</label>
            <input id="bootstrap-token" name="bootstrapToken" type="password" autocomplete="one-time-code" maxlength="256" hidden />
            <label for="passphrase">Passphrase</label>
            <input id="passphrase" name="passphrase" type="password" autocomplete="current-password" minlength="12" maxlength="1024" required />
            <label class="remember"><input id="remember-me" type="checkbox" /> Keep me signed in on this browser</label>
            <button id="auth-submit" class="button button-primary" type="submit">Sign in</button>
        </form>
    </section>
    <section id="chat" class="workspace" hidden aria-label="Jarvis workspace">
        <aside class="sidebar" aria-label="Workspace navigation">
            <button id="new-conversation" class="button button-new" type="button"><span aria-hidden="true">+</span> New conversation</button>
            <h2 class="section-label">Recent conversations</h2>
            <ul id="conversation-list" class="conversation-list"></ul>
            <nav class="sidebar-actions" aria-label="Chat actions">
                <button id="settings-button" class="nav-button" type="button"><span aria-hidden="true">⚙</span> Settings</button>
                <button id="activity-button" class="nav-button" type="button"><span aria-hidden="true">◷</span> Activity</button>
                <button id="approvals-button" class="nav-button" type="button">Approvals</button>
                <button id="memory-button" class="nav-button" type="button">Memory</button>
                <button id="household-button" class="nav-button" type="button">Household</button>
                <button id="logout" class="nav-button" type="button"><span aria-hidden="true">↪</span> Sign out</button>
            </nav>
        </aside>
        <div class="workspace-main">
            <header class="workspace-header">
                <div>
                    <p class="eyebrow">Your private space</p>
                    <h1>Good to see you.</h1>
                </div>
                <p id="route-status" class="route-status"></p>
            </header>
            <section id="conversation" class="conversation-view" hidden aria-label="Conversation">
                <header class="conversation-heading">
                    <div>
                        <p class="eyebrow">Conversation</p>
                        <h2 id="conversation-title">Conversation</h2>
                        <p id="conversation-created" class="conversation-created"></p>
                    </div>
                    <button id="rename-conversation" class="button button-secondary" type="button">Rename</button>
                </header>
                <form id="rename-form" class="rename-form" hidden>
                    <label for="conversation-title-input">Conversation title</label>
                    <input id="conversation-title-input" name="title" maxlength="200" required />
                    <div class="rename-actions">
                        <button id="save-title" class="button button-primary" type="submit">Save title</button>
                        <button id="cancel-title" class="button button-secondary" type="button">Cancel</button>
                    </div>
                </form>
                <ol id="messages" class="messages" aria-label="Conversation history"></ol>
                <p id="stream-status" class="sr-only" role="status" aria-live="polite"></p>
                <p id="response-announcement" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
                <form id="turn-form" class="composer">
                    <label class="sr-only" for="prompt">Message</label>
                    <textarea id="prompt" name="text" maxlength="8000" aria-describedby="composer-help" placeholder="Message Jarvis…" required></textarea>
                    <div class="composer-footer">
                        <p id="composer-help">Enter to send <span aria-hidden="true">·</span> Shift+Enter for a new line</p>
                        <div class="composer-actions">
                            <button id="cancel-turn" class="button button-secondary" type="button" hidden>Cancel turn</button>
                            <button id="send-turn" class="button button-primary" type="submit">Send <span aria-hidden="true">↗</span></button>
                        </div>
                    </div>
                </form>
            </section>
            <section id="settings" class="surface-card settings-view" hidden aria-labelledby="settings-title">
                <p class="eyebrow">Your preferences</p>
                <h2 id="settings-title">Local settings</h2>
                <p id="settings-status" class="inline-status" role="status"></p>
                <form id="retention-form">
                    <label for="conversation-days">Conversation retention <span>days</span></label>
                    <input id="conversation-days" type="number" min="1" max="3650" required />
                    <label for="audit-days">Audit retention <span>days</span></label>
                    <input id="audit-days" type="number" min="1" max="3650" required />
                    <button class="button button-primary" type="submit">Save settings</button>
                </form>
            </section>
            <section id="activity" class="surface-card activity-view" hidden aria-labelledby="activity-title">
                <p class="eyebrow">A clear local record</p>
                <h2 id="activity-title">Local activity</h2>
                <p>Recent turns and action outcomes are shown without prompts, provider payloads, or secrets.</p>
                <p id="activity-status" class="inline-status" role="status"></p>
                <h3>Tool and action outcomes</h3>
                <ul id="action-list" class="activity-list"></ul>
                <h3>Approval decisions</h3>
                <ul id="audit-list" class="activity-list"></ul>
                <h3>Recent turns</h3>
                <ul id="activity-list" class="activity-list"></ul>
            </section>
            <section id="approvals" class="surface-card" hidden aria-labelledby="approvals-title">
                <p class="eyebrow">Exact, short-lived consent</p>
                <h2 id="approvals-title">Pending approvals</h2>
                <p>Review the exact registered action and its expiry. Approval authorizes only the displayed action.</p>
                <p id="approvals-status" class="inline-status" role="status"></p>
                <ul id="approval-list" class="activity-list"></ul>
            </section>
            <section id="memory" class="surface-card memory-view" hidden aria-labelledby="memory-title">
                <p class="eyebrow">Owner-confirmed, stored locally</p>
                <h2 id="memory-title">Memory</h2>
                <p>Facts are evidence, not instructions. Enter an exact change here or ask Jarvis to propose one. Nothing is saved until you approve its exact proposal.</p>
                <form id="memory-search-form">
                    <label for="memory-query">Search remembered facts</label>
                    <div class="inline-form">
                        <input id="memory-query" type="search" maxlength="512" />
                        <button class="button button-secondary" type="submit">Search</button>
                    </div>
                </form>
                <form id="memory-request-form">
                    <label for="memory-operation">Change type</label>
                    <select id="memory-operation">
                        <option value="create">Remember a new fact</option>
                        <option value="update">Edit this fact</option>
                        <option value="delete">Forget this fact</option>
                    </select>
                    <input id="memory-target-id" type="hidden" />
                    <input id="memory-target-version" type="hidden" />
                    <label for="memory-subject">Subject</label>
                    <input id="memory-subject" maxlength="256" required />
                    <label for="memory-key">Fact key</label>
                    <input id="memory-key" maxlength="128" required />
                    <label for="memory-value">Exact fact value</label>
                    <textarea id="memory-value" maxlength="8192" required></textarea>
                    <div id="memory-conflict-review" hidden>
                        <p>Review these current facts before choosing how this proposal handles the conflicts:</p>
                        <ul id="memory-conflict-list" class="activity-list"></ul>
                        <label for="memory-conflict-choice">Conflict decision</label>
                        <select id="memory-conflict-choice">
                            <option value="">Choose how to resolve these conflicts</option>
                            <option value="retain_both">Keep a separate fact with distinguishing context</option>
                            <option value="supersede">Replace the matching facts</option>
                        </select>
                        <label for="memory-distinguishing-context">Distinguishing context (required to keep both)</label>
                        <input id="memory-distinguishing-context" maxlength="512" />
                    </div>
                    <button class="button button-primary" type="submit">Prepare exact proposal</button>
                </form>
                <p id="memory-status" class="inline-status" role="status"></p>
                <ul id="memory-list" class="activity-list"></ul>
            </section>
            <section id="household" class="surface-card" hidden aria-labelledby="household-title">
                <p class="eyebrow">Approved resources only</p>
                <h2 id="household-title">Household connection</h2>
                <p id="household-status" class="inline-status" role="status"></p>
                <p>Connection status is configuration-only until an operation probes the service. Secret values are never shown here.</p>
                <ul id="household-list" class="activity-list"></ul>
            </section>
        </div>
    </section>
    <p id="error" class="error-banner" role="alert" hidden></p>
</main>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<script src="~/js/chat.js" asp-append-version="true"></script>
